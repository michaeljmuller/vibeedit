# Copy to .env and fill in. .env is gitignored — never commit real secrets.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Production: https://edit.themullers.org/auth/google/callback
GOOGLE_CALLBACK_URL=

# Generate with: openssl rand -hex 32
SESSION_SECRET=

# Local testing only: skip Google and sign in as this address.
_SINGLE_USER_EMAIL=

# Set to "no" in dev to keep the container from restarting on its own.
RESTART_POLICY=
